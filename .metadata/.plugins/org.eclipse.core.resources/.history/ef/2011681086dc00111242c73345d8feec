void motor_set(uint8_t dut, uint8_t reverse){
	uint32_t ccr = duty * 20;
	if (reverse != motor_dir) {
		motor_stop();
		HAL_Delay(100);
		motor_dir = reverse;
	}
	if (reverse) {
		TIM3->CCR1 = 0;
		TIM3->CCR3 = ccr;
	} else {
		TIM3->CCR3 = 0;
		TIM3->CCR1 = ccr;
	}
}
void motor_stop(void){
	TIM3->CCR1 = 0;
	TIM3->CCR3 = 0;
}
void servo_select(uint8_t id){
	static const uint16_t pulse[4] = {600, 1200, 1800, 2400};
    TIM2->CCR1 = pulse[id];
}

void rgb_write(uint8_t r, uint8_t g, uint8_t b) {
    HAL_GPIO_WritePin(RED_GPIO_Port, RED_Pin, r ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GRN_GPIO_Port, GRN_Pin, g ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(BLU_GPIO_Port, BLU_Pin, b ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

void rbg_set(uint8_t id){
    switch (id) {
    case 0: rgb_write(1, 0, 1); break;   // Inlet = 紫
    case 1: rgb_write(1, 0, 0); break;   // Zone 1 = 红
    case 2: rgb_write(0, 1, 0); break;   // Zone 2 = 绿
    case 3: rgb_write(0, 0, 1); break;   // Zone 3 = 蓝
    }
}

void rbg_off(void){
	rgb_write(0, 0, 0);
}

void rbg_white_toggle(void){
    static uint8_t on = 0;
    on = !on;
    rgb_write(on, on, on);
}

void HCSR04_TRIG_PULSE(void) {
    HAL_GPIO_WritePin(HCSR04_Out_GPIO_Port, HCSR04_Out_Pin, GPIO_PIN_SET);
    for (volatile int j = 0; j != 15; j = j + 1) {}
    HAL_GPIO_WritePin(HCSR04_Out_GPIO_Port, HCSR04_Out_Pin, GPIO_PIN_RESET);
}

uint8_t depth_read_pct(void){
    hcsr04_Rx_flag = 0;
    first_edge = 0;
    HCSR04_TRIG_PULSE();

    uint32_t t0 = HAL_GetTick();
    while (hcsr04_Rx_flag == 0) {
        if (HAL_GetTick() - t0 > 60) return depth_pct;
    }
    uint16_t time_diff = time_edge2 - time_edge1;
    int us_full  = D_FULL_CM  * 58;
    int us_empty = D_EMPTY_CM * 58;
    int pct = (us_empty - (int)time_diff) * 100 / (us_empty - us_full);
    if (pct < 0)  pct = 0;
    if (pct > 99) pct = 99;
    return (uint8_t)pct;
}
#define BIT(v, n) ((v) >> (n)) & 1 ? GPIO_PIN_SET : GPIO_PIN_RESET)
void display_show(uint8_t pct){}
