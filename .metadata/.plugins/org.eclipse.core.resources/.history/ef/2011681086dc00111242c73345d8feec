/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  MX_TIM5_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_Base_Start_IT(&htim5);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  switch (mode) {
	  case SETUP:
	      run_setup();
	      mode = WAIT_B1;
	      break;

	  case WAIT_B1:
	      wait_b1();
	      start_run();
	      mode = RUN;
	      break;

	  case RUN:
	      if (tick_flag) {
	          tick_flag = 0;
	          minute++;
	          if (minute == 10) rpm_pulses = 0;
	          if (cur && motor_on && cur->pwm_option == 0) {
	              cur_duty = pot_read_pct();
	              motor_set(cur_duty, cur->id == 0);
	          }
	          if (minute == 60) { minute = 0; end_hour(); }
	      }
	      break;

	  case HALT:
	      if (empty_event) { rgb_white_toggle(); HAL_Delay(250); }
	      break;
	  }
  }
  /* USER CODE END 3 */
}

