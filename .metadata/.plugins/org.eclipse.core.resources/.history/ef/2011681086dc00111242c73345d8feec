int read_num(const char *prompt, int min, int max) {
	char buf[4];
	uint8_t len, c;
	while (1) {
		term_print(prompt);
		len = 0;
		while (1) {
			HAL_UART_Receive(TERM, &c, HAL_MAX_DELAY);
            if (c == '\r' || c == '\n') { if (len) break; else continue; }
            if (c >= '0' && c <= '9' && len < 3) {
                buf[len++] = c;
                HAL_UART_Transmit(TERM, &c, 1, HAL_MAX_DELAY);
            }
		}
		term_print("\r\n");
		int v = 0;
        for (uint8_t i = 0; i < len; i++) v = v * 10 + (buf[i] - '0');
        if (v >= min && v <= max) return v;
        term_print("Invalid, try again\r\n");
	}
}

void run_setup(void) {
	static const char *ord[3] = {"FIRST", "SECOND", "THIRD"};
	char p[80];

	motor_stop();
	HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
	term_print("\r\nSETUP MODE\r\n");

	plan[0].id = 0;
	plan[0].pwm_option = read_number("INLET PIPELINE PUMP MOTOR PMW (0-3): ", 0, 3);
	for (int i = 0; i < 3; i++) {
		sprintf(p, "%s ZONE CHOIC EFOR IRRIGATION (1-3): ", ord[i]);
		plan[i + 1].id = read_number(p, 1, 3);
		sprintf(p, "%s ZONE CHOICE FOR PUMP MOTOR PWM OPTION (1-3): ", ord[i]);
		plan[i + 1].pwm_option = read_number(p, 1, 3);
	}

	plan[0].start_hour = read_number("INLET WALL CLOCK START TIME (00-23): ", 0, 23);
	plan[0].stop_hour = read_number("INLET WALL CLOCK STOP TIME (00-23)", 0, 23);
	for(int i = 0; i < 3; i++) {
		sprintf(p, "%s ZONE WALL CLOCK START TIME (00-23): ", ord[i]);
		plan[i + 1].start_hour = read_number(p, 0, 23);
		sprintf(p, "%s ZONE WALL CLOCK STOP TIME (00-23): ", ord[i]);
		plan[i + 1].stop_hour = read_number(p, 0, 23);
	}

	term_print("\r\n--- SETUP SUMMARY ---\r\n");
    for (int i = 0; i < 4; i++) {
        if (plan[i].id == 0) sprintf(p, "INLET : ");
        else                 sprintf(p, "ZONE %d: ", plan[i].id);
        term_print(p);
        if (plan[i].pwm_option == 0) sprintf(p, "PWM = MANUAL, ");
        else sprintf(p, "PWM option %d (%d%%), ", plan[i].pwm_option, duty_table[plan[i].pwm_option]);
        term_print(p);
        sprintf(p, "start %02d:00, stop %02d:00\r\n", plan[i].start_hour, plan[i].stop_hour);
        term_print(p);
    }
    term_print("Press B1 to start RUN MODE\r\n");
}

void wait_b1(void) {
	b1_flag = 0;
	while (!b1_flag) {
		HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
		HAL_Delay(200);
	}
	while (HAL_GPIO_ReadPin(PB_INPUT_GPIO_Port, PB_INPUT_Pin) == GPIO_PIN_RESET) {}
}

// decide what to do this hour
void begin_hour(void) {
	cur = NULL;
	for (int i = 0; i < 4; i++)
	        if (hour >= plan[i].start_hour && hour < plan[i].stop_hour) cur = &plan[i];

	   if (cur == NULL) { motor_stop(); motor_on = 0; cur_duty = 0; rgb_off(); return; }

	   servo_select(cur->id);
	   rgb_set(cur->id);

	   if(cur->id == 0 && depth_pct >= FULL_PCT) {
		   motor_stop();
		   motor_on = 0;
		   cur_duty = 0;
		   filled = 1;
	   }
	   cur_duty = cur->pwm_option ? duty_table[cur->pwm_option] : pot_read_pct();
	   motor_set(cur_duty, cur->id == 0);
	   motor_on = 1;
}

void special_event(void) {
	motor_stop(); motor_on = 0;
	HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
	term_print("*** RESERVOIR IS EMPTY ***\r\n");
	empty_event = 1;
	mode = HALT;
}

void end_hour(void) {
	char line[80];
	uint32_t rpm = rpm_pulses * 6 /SLOTS_PER_REV;

	depth_pct = depth_read_pct();
	display_show(depth_pct);

	if(cur) {
		char name[8];
		if(cur->id == 0){
			sprintf(name, "INLET");
		} else {
			sprintf(name, "ZONE %d", cur->id);
		}
        sprintf(line, "%02d:00 | %-6s | %3d%% | %5lu | %2d%%\r\n",
                hour, name, cur_duty, rpm, depth_pct);
	} else {
        sprintf(line, "%02d:00 |        |      | %5lu | %2d%%\r\n",
                hour, rpm, depth_pct);
	}
	term_print(line);

    if (cur && cur->id == 0 &&
        (depth_pct >= FULL_PCT || hour + 1 >= cur->stop_hour)) filled = 1;

    if (filled && depth_pct == 0) { special_event(); return; }

    if (++hour == 24) {
        motor_stop(); motor_on = 0; rgb_off();
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
        term_print("24 HOURS DONE - press RESET\r\n");
        mode = HALT;
        return;
    }
    begin_hour();
}

void start_run(void) {
	hour = 0;
	minute = 0;
	filled = 0;
	empty_event = 0;
	HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
    term_print("\r\nRUN MODE\r\n");
    term_print("Time  | Pipe   | PWM  |  RPM  | Depth\r\n");
    depth_pct = depth_read_pct();
    display_show(depth_pct);
    __HAL_TIM_SET_COUNTER(&htim5, 0);
    tick_flag = 0;
    begin_hour();
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == USART2) rcv_intpt_flag = 1;
}

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM4 && htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1) {
        if (first_edge == 0) {
            time_edge1 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1);
            first_edge = 1;
        } else {
            time_edge2 = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1);
            hcsr04_Rx_flag = 1;
        }
    }
}
